 CefBasicPanelView::CefBasicPanelView(CefPanelDelegate* cef_delegate)
     : ParentClass(cef_delegate) {}
 
+CefBasicPanelView::~CefBasicPanelView() {
+  DetachMatteWindow();
+#if defined(USE_AURA)
+  if (matte_window_ && matte_window_->layer()) {
+    matte_window_->layer()->set_delegate(nullptr);
+  }
+  matte_window_.reset();
+  matte_delegate_.reset();
+#endif
+}
+
+void CefBasicPanelView::SetViewportCutout(bool enabled,
+                                          int x,
+                                          int y,
+                                          int width,
+                                          int height,
+                                          int corner_radius,
+                                          int blur_radius,
+                                          SkColor tint_color,
+                                          SkColor border_color) {
+  matte_enabled_ = enabled;
+  cutout_x_ = x;
+  cutout_y_ = y;
+  cutout_width_ = width;
+  cutout_height_ = height;
+  cutout_radius_ = corner_radius;
+  blur_radius_ = blur_radius;
+  tint_color_ = tint_color;
+  border_color_ = border_color;
+  SetCanProcessEventsWithinSubtree(!enabled);
+  SyncMatteWindow();
+}
+
+void CefBasicPanelView::AddedToWidget() {
+  ParentClass::AddedToWidget();
+  SyncMatteWindow();
+}
+
+void CefBasicPanelView::RemovedFromWidget() {
+  DetachMatteWindow();
+  ParentClass::RemovedFromWidget();
+}
+
+void CefBasicPanelView::OnBoundsChanged(const gfx::Rect& previous_bounds) {
+  ParentClass::OnBoundsChanged(previous_bounds);
+  if (matte_enabled_) {
+    SyncMatteWindow();
+  }
+}
+
+void CefBasicPanelView::VisibilityChanged(views::View* starting_from,
+                                          bool is_visible) {
+  ParentClass::VisibilityChanged(starting_from, is_visible);
+  if (matte_enabled_) {
+    SyncMatteWindow();
+  }
+}
+
+SkPath CefBasicPanelView::BuildCutoutPath() const {
+  SkPathBuilder builder(SkPathFillType::kEvenOdd);
+  builder.addRect(SkRect::MakeWH(width(), height()));
+  if (cutout_width_ > 0 && cutout_height_ > 0) {
+    SkRect cut = SkRect::MakeXYWH(cutout_x_, cutout_y_,
+                                  cutout_width_, cutout_height_);
+    if (cutout_radius_ > 0) {
+      float r = static_cast<float>(cutout_radius_);
+      builder.addRRect(SkRRect::MakeRectXY(cut, r, r));
+    } else {
+      builder.addRect(cut);
+    }
+  }
+  return builder.detach();
+}
+
+void CefBasicPanelView::SyncMatteWindow() {
+#if defined(USE_AURA)
+  views::Widget* widget = GetWidget();
+  if (!matte_enabled_ || !widget || !widget->GetNativeView()) {
+    if (matte_window_) {
+      matte_window_->Hide();
+    }
+    return;
+  }
+  bool need_reorder = false;
+  if (!matte_window_) {
+    matte_delegate_ = std::make_unique<MatteLayerDelegate>(this);
+    matte_window_ = std::make_unique<aura::Window>(nullptr);
+    matte_window_->Init(ui::LAYER_TEXTURED);
+    matte_window_->set_owned_by_parent(false);
+    matte_window_->SetTransparent(true);
+    matte_window_->SetEventTargetingPolicy(aura::EventTargetingPolicy::kNone);
+    matte_window_->SetProperty(views::kHostViewKey,
+                               static_cast<views::View*>(this));
+    matte_window_->layer()->set_delegate(matte_delegate_.get());
+    matte_window_->layer()->SetFillsBoundsOpaquely(false);
+    matte_window_->layer()->SetAcceptEvents(false);
+    need_reorder = true;
+  }
+  if (matte_window_->parent() != widget->GetNativeView()) {
+    views::Widget::ReparentNativeView(matte_window_.get(),
+                                      widget->GetNativeView());
+    need_reorder = true;
+  }
+  gfx::Rect bounds_in_widget = ConvertRectToWidget(GetLocalBounds());
+  matte_window_->SetBounds(bounds_in_widget);
+  if (IsDrawn()) {
+    matte_window_->Show();
+  } else {
+    matte_window_->Hide();
+  }
+  if (need_reorder) {
+    widget->ReorderNativeViews();
+  }
+  if (blur_radius_ > 0 && width() > 0 && height() > 0) {
+    matte_window_->layer()->SetBackgroundBlur(
+        static_cast<float>(blur_radius_));
+    matte_window_->layer()->SetBackdropFilterQuality(0.33f);
+    matte_window_->layer()->SetBackdropFilterBounds(BuildCutoutPath());
+  } else {
+    matte_window_->layer()->SetBackgroundBlur(0.0f);
+    matte_window_->layer()->ClearBackdropFilterBounds();
+  }
+  matte_window_->layer()->SchedulePaint(gfx::Rect(size()));
+#endif
+}
+
+void CefBasicPanelView::DetachMatteWindow() {
+#if defined(USE_AURA)
+  if (!matte_window_) {
+    return;
+  }
+  matte_window_->Hide();
+  matte_window_->ClearProperty(views::kHostViewKey);
+  if (matte_window_->parent()) {
+    matte_window_->parent()->RemoveChild(matte_window_.get());
+  }
+#endif
+}
+
+void CefBasicPanelView::PaintMatteLayer(const ui::PaintContext& context) {
+#if defined(USE_AURA)
+  if (!matte_enabled_ || width() <= 0 || height() <= 0) {
+    return;
+  }
+  ui::PaintRecorder recorder(context, size());
+  SkPath path = BuildCutoutPath();
+  if (SkColorGetA(tint_color_) > 0) {
+    cc::PaintFlags fill;
+    fill.setAntiAlias(true);
+    fill.setStyle(cc::PaintFlags::kFill_Style);
+    fill.setColor(tint_color_);
+    recorder.canvas()->DrawPath(path, fill);
+  }
+  if (cutout_width_ > 0 && cutout_height_ > 0 &&
+      SkColorGetA(border_color_) > 0) {
+    cc::PaintFlags stroke;
+    stroke.setAntiAlias(true);
+    stroke.setStyle(cc::PaintFlags::kStroke_Style);
+    stroke.setStrokeWidth(1.0f);
+    stroke.setColor(border_color_);
+    SkRect cut = SkRect::MakeXYWH(cutout_x_, cutout_y_,
+                                  cutout_width_, cutout_height_);
+    SkRect border_rect = cut.makeOutset(0.5f, 0.5f);
+    float r = cutout_radius_ > 0
+                  ? static_cast<float>(cutout_radius_) + 0.5f
+                  : 0.0f;
+    recorder.canvas()->sk_canvas()->drawRRect(
+        SkRRect::MakeRectXY(border_rect, r, r), stroke);
+  }
+#else
+  (void)context;
+#endif
+}
