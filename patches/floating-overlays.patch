+void CefBrowserViewImpl::SetBackgroundBlur(int radius) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  if (radius < 0) {
+    radius = 0;
+  }
+  background_blur_ = radius;
+  ApplyBackgroundBlur();
