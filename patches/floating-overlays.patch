+
+void CefBrowserViewImpl::ApplyBackgroundBlur() {
+  views::WebView* view = web_view();
+  if (!view) {
+    return;
+  }
+  views::View* blur_view = nullptr;
+  for (views::View* child : view->children()) {
+    if (child->GetID() == kBackdropBlurViewId) {
+      blur_view = child;
+      break;
+    }
+  }
+  const int radius = background_blur_.value_or(0);
+  if (radius <= 0) {
+    if (blur_view) {
+      blur_view->SetVisible(false);
+      if (ui::Layer* layer = blur_view->layer()) {
+        layer->SetBackgroundBlur(0.0f);
+      }
+    }
+    return;
+  }
+  bool created = false;
+  if (!blur_view) {
+    auto new_view = std::make_unique<views::View>();
+    new_view->SetID(kBackdropBlurViewId);
+    new_view->SetCanProcessEventsWithinSubtree(false);
+    new_view->SetPaintToLayer();
+    blur_view = view->AddChildViewAt(std::move(new_view), 0);
+    created = true;
+  }
+  blur_view->SetVisible(true);
+  blur_view->SetBoundsRect(view->GetContentsBounds());
+  if (ui::Layer* layer = blur_view->layer()) {
+    layer->SetFillsBoundsOpaquely(false);
+    const float corner = static_cast<float>(corner_radius_.value_or(0));
+    layer->SetRoundedCornerRadius(gfx::RoundedCornersF(corner));
+    layer->SetIsFastRoundedCorner(corner > 0.0f);
+    layer->SetBackgroundBlur(static_cast<float>(radius));
+    layer->SetBackdropFilterQuality(0.33f);
+  }
+  if (created) {
+    if (views::Widget* widget = view->GetWidget()) {
+      widget->ReorderNativeViews();
+    }
+  }
+}
+
+void CefBrowserViewImpl::SetSafeAreaInsets(int top,
+                                           int left,
+                                           int bottom,
+                                           int right) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  safe_area_insets_ = gfx::Insets::TLBR(
+      std::max(0, top), std::max(0, left),
+      std::max(0, bottom), std::max(0, right));
+  ApplySafeAreaInsets();
+}
+
+void CefBrowserViewImpl::ApplySafeAreaInsets() {
+  if (!safe_area_insets_.has_value()) {
+    return;
+  }
+  views::WebView* view = web_view();
+  if (!view || !view->web_contents()) {
+    return;
+  }
+  WebContentsSafeAreaObserver::SetForWebContents(view->web_contents(),
+                                                 *safe_area_insets_);
+}
