+class WebContentsSafeAreaObserver
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<WebContentsSafeAreaObserver> {
+ public:
+  static void SetForWebContents(content::WebContents* web_contents,
+                                const gfx::Insets& insets) {
+    if (!web_contents) {
+      return;
+    }
+    auto* observer = FromWebContents(web_contents);
+    if (!observer) {
+      observer = new WebContentsSafeAreaObserver(web_contents);
+      web_contents->SetUserData(UserDataKey(), base::WrapUnique(observer));
+    }
+    observer->SetInsets(insets);
+  }
