+  WebContentsSafeAreaObserver(const WebContentsSafeAreaObserver&) = delete;
+  WebContentsSafeAreaObserver& operator=(const WebContentsSafeAreaObserver&) =
+      delete;
+
+  ~WebContentsSafeAreaObserver() override = default;
+
+  void SetInsets(const gfx::Insets& insets) {
+    insets_ = insets;
+    SendToFrame(web_contents()->GetPrimaryMainFrame());
+  }
+
+ private:
+  friend class content::WebContentsUserData<WebContentsSafeAreaObserver>;
+
+  explicit WebContentsSafeAreaObserver(content::WebContents* web_contents)
+      : content::WebContentsObserver(web_contents),
+        content::WebContentsUserData<WebContentsSafeAreaObserver>(
+            *web_contents) {}
+
+  void RenderFrameCreated(content::RenderFrameHost* rfh) override {
+    if (!rfh->GetParentOrOuterDocument()) {
+      SendToFrame(rfh);
+    }
+  }
+
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame() && handle->HasCommitted()) {
+      SendToFrame(handle->GetRenderFrameHost());
+    }
+  }
+
+  void DidToggleFullscreenModeForTab(bool entered_fullscreen,
+                                     bool will_cause_resize) override {
+    SendToFrame(web_contents()->GetPrimaryMainFrame());
+  }
+
+  void SendToFrame(content::RenderFrameHost* rfh) {
+    if (!rfh || rfh->GetParentOrOuterDocument() || !rfh->IsRenderFrameLive()) {
+      return;
+    }
+    blink::AssociatedInterfaceProvider* provider =
+        rfh->GetRemoteAssociatedInterfaces();
+    if (!provider) {
+      return;
+    }
+    mojo::AssociatedRemote<blink::mojom::DisplayCutoutClient> client;
+    provider->GetInterface(client.BindNewEndpointAndPassReceiver());
+    client->SetSafeArea(web_contents()->IsFullscreen() ? gfx::Insets()
+                                                       : insets_);
+  }
+
+  gfx::Insets insets_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
