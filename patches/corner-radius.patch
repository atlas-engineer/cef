+void CefBrowserViewImpl::SetCornerRadius(int radius) {
+  CEF_REQUIRE_VALID_RETURN_VOID();
+  if (radius < 0) {
+    radius = 0;
+  }
+  corner_radius_ = radius;
+  ApplyCornerRadius();
+}
+
+void CefBrowserViewImpl::ApplyCornerRadius() {
+  if (!corner_radius_.has_value()) {
+    return;
+  }
+  views::WebView* view = web_view();
+  if (!view) {
+    return;
+  }
+  const gfx::RoundedCornersF radii(static_cast<float>(corner_radius_.value()));
+  for (views::View* child : view->children()) {
+    if (auto* host = views::AsViewClass<views::NativeViewHost>(child)) {
+      host->SetCornerRadii(radii);
+    }
+  }
+}
+
 cef_runtime_style_t CefBrowserViewImpl::GetRuntimeStyle() {
   CEF_REQUIRE_VALID_RETURN(CEF_RUNTIME_STYLE_DEFAULT);
   return IsAlloyStyle() ? CEF_RUNTIME_STYLE_ALLOY : CEF_RUNTIME_STYLE_CHROME;
